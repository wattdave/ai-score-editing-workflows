{
	Initialize "() {
		AddToPluginsMenu('Sibelius Websocket CLI Bridge','Run');
	}"

	Run "() {
		Sibelius.MessageBox('This plug-in is the bridge for sibelius-websocket-cli. It is meant to be called over Sibelius Connect (invokePlugin), not from the menu.');
	}"

	GetBridgeVersion "() {
		return CreateDictionary('version', 39);
	}"

	Echo "(value) {
		return value;
	}"

	RequireScore "() {
		if (Sibelius.ScoreCount = 0) {
			return null;
		}
		return Sibelius.ActiveScore;
	}"

	GetScoreInfo "() {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		keySignatures = CreateSparseArray();
		timeSignatures = CreateSparseArray();
		systemStaff = score.SystemStaff;
		for barNum = 1 to systemStaff.BarCount + 1 {
			bar = systemStaff.NthBar(barNum);
			for each KeySignature ks in bar {
				keySignatures.Push(CreateDictionary(
					'bar', barNum, 'name', ks.AsText, 'sharps', ks.Sharps, 'major', ks.Major));
			}
			for each TimeSignature ts in bar {
				timeSignatures.Push(CreateDictionary(
					'bar', barNum, 'numerator', ts.Numerator, 'denominator', ts.Denominator));
			}
		}
		return CreateDictionary(
			'fileName', score.FileName & '',
			'title', score.Title,
			'composer', score.Composer,
			'lyricist', score.Lyricist,
			'copyright', score.Copyright,
			'staffCount', score.StaffCount,
			'barCount', systemStaff.BarCount,
			'keySignatures', keySignatures,
			'timeSignatures', timeSignatures,
			'mainTextFontName', score.MainTextFontName & '',
			'mainMusicFontName', score.MainMusicFontName & '',
			'musicTextFontName', score.MusicTextFontName & '');
	}"

	GetStaves "() {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		staves = CreateSparseArray();
		for i = 1 to score.StaffCount + 1 {
			staff = score.NthStaff(i);
			staves.Push(CreateDictionary(
				'staffNum', i,
				'instrumentName', staff.InstrumentName,
				'fullInstrumentName', staff.FullInstrumentName,
				'barCount', staff.BarCount));
		}
		return staves;
	}"

	GetSelectionInfo "() {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		selection = score.Selection;
		if (selection.IsPassage) {
			return CreateDictionary(
				'isPassage', True,
				'topStaff', selection.TopStaff,
				'bottomStaff', selection.BottomStaff,
				'firstBar', selection.FirstBarNumber,
				'lastBar', selection.LastBarNumber);
		}
		return CreateDictionary('isPassage', False);
	}"

	DescribeObject "(obj, index) {
		if (obj.Type = 'NoteRest') {
			notes = CreateSparseArray();
			for each note in obj {
				notes.Push(CreateDictionary(
					'pitch', note.Pitch,
					'name', note.Name,
					'tied', note.Tied));
			}
			return CreateDictionary(
				'index', index,
				'type', obj.Type,
				'position', obj.Position,
				'voice', obj.VoiceNumber,
				'duration', obj.Duration,
				'beam', obj.Beam,
				'notes', notes);
		}
		if (obj.Type = 'LyricItem') {
			syllableType = 'end';
			if (obj.SyllableType = MiddleOfWord) {
				syllableType = 'middle';
			}
			return CreateDictionary(
				'index', index,
				'type', obj.Type,
				'position', obj.Position,
				'voice', obj.VoiceNumber,
				'text', obj.Text,
				'syllableType', syllableType,
				'styleId', '' & obj.StyleId,
				'styleAsText', '' & obj.StyleAsText,
				'hidden', obj.Hidden,
				'dy', obj.Dy,
				'dx', obj.Dx);
		}
		if (obj.Type = 'KeySignature') {
			return CreateDictionary(
				'index', index, 'type', obj.Type, 'position', obj.Position,
				'name', obj.AsText, 'sharps', obj.Sharps, 'major', obj.Major);
		}
		if (obj.Type = 'TimeSignature') {
			return CreateDictionary(
				'index', index, 'type', obj.Type, 'position', obj.Position,
				'numerator', obj.Numerator, 'denominator', obj.Denominator);
		}
		if (obj.Type = 'Clef') {
			return CreateDictionary(
				'index', index, 'type', obj.Type, 'position', obj.Position,
				'styleId', obj.StyleId);
		}
		if (obj.Type = 'Text') {
			return CreateDictionary(
				'index', index, 'type', obj.Type, 'position', obj.Position,
				'text', obj.Text, 'styleId', '' & obj.StyleId);
		}
		if (obj.IsALine) {
			return CreateDictionary(
				'index', index, 'type', obj.Type, 'position', obj.Position,
				'styleId', '' & obj.StyleId, 'duration', obj.Duration,
				'endBarNumber', obj.EndBarNumber, 'endPosition', obj.EndPosition);
		}
		return CreateDictionary('index', index, 'type', obj.Type, 'position', obj.Position);
	}"

	ReadBars "(staffNum, fromBar, toBar) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		staff = score.NthStaff(staffNum);
		if (fromBar < 1 or toBar > staff.BarCount or fromBar > toBar) {
			return CreateDictionary('error', 'bar range out of range');
		}
		bars = CreateSparseArray();
		for barNum = fromBar to toBar + 1 {
			bar = staff.NthBar(barNum);
			objects = CreateSparseArray();
			index = 0;
			for each obj in bar {
				objects.Push(DescribeObject(obj, index));
				index = index + 1;
			}
			bars.Push(CreateDictionary('barNumber', barNum, 'objects', objects));
		}
		return bars;
	}"

	ReadLyrics "(staffNum, fromBar, toBar) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 0 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		firstStaff = staffNum;
		lastStaff = staffNum;
		if (staffNum = 0) {
			firstStaff = 1;
			lastStaff = score.StaffCount;
		}
		lyrics = CreateSparseArray();
		for s = firstStaff to lastStaff + 1 {
			staff = score.NthStaff(s);
			startBar = 1;
			endBar = staff.BarCount;
			if (fromBar != null and fromBar > 1) {
				startBar = fromBar;
			}
			if (toBar != null and toBar > 0 and toBar < endBar) {
				endBar = toBar;
			}
			for barNum = startBar to endBar + 1 {
				bar = staff.NthBar(barNum);
				index = 0;
				for each obj in bar {
					if (obj.Type = 'LyricItem') {
						syllableType = 'end';
						if (obj.SyllableType = MiddleOfWord) {
							syllableType = 'middle';
						}
						lyrics.Push(CreateDictionary(
							'staff', s,
							'bar', barNum,
							'index', index,
							'position', obj.Position,
							'voice', obj.VoiceNumber,
							'text', obj.Text,
							'syllableType', syllableType,
							'styleId', '' & obj.StyleId,
							'styleAsText', '' & obj.StyleAsText,
							'hidden', obj.Hidden,
							'dy', obj.Dy));
					}
					index = index + 1;
				}
			}
		}
		return lyrics;
	}"

	GetObjectAt "(staffNum, barNumber, index) {
		score = Sibelius.ActiveScore;
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return null;
		}
		staff = score.NthStaff(staffNum);
		if (barNumber < 1 or barNumber > staff.BarCount) {
			return null;
		}
		bar = staff.NthBar(barNumber);
		i = 0;
		for each obj in bar {
			if (i = index) {
				return obj;
			}
			i = i + 1;
		}
		return null;
	}"

	SetLyricText "(staffNum, barNumber, index, newText) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		if (obj.Type != 'LyricItem') {
			return CreateDictionary('error', 'object at address is a ' & obj.Type & ', not a LyricItem');
		}
		oldText = obj.Text;
		obj.Text = newText;
		return CreateDictionary('oldText', oldText, 'newText', obj.Text);
	}"

	TransposePassage "(fromBar, toBar, topStaff, bottomStaff, degree, intervalType) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (fromBar < 1 or toBar > score.SystemStaff.BarCount or fromBar > toBar) {
			return CreateDictionary('error', 'bar range out of range');
		}
		if (topStaff < 1 or bottomStaff > score.StaffCount or topStaff > bottomStaff) {
			return CreateDictionary('error', 'staff range out of range');
		}
		selection = score.Selection;
		selection.SelectPassage(fromBar, toBar, topStaff, bottomStaff);
		selection.Transpose(degree, intervalType, True, True);
		selection.Clear();
		return CreateDictionary(
			'degree', degree, 'intervalType', intervalType,
			'fromBar', fromBar, 'toBar', toBar,
			'topStaff', topStaff, 'bottomStaff', bottomStaff);
	}"

	SetKeySignature "(barNumber, keyName, major) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		systemStaff = score.SystemStaff;
		if (barNumber < 1 or barNumber > systemStaff.BarCount) {
			return CreateDictionary('error', 'barNumber out of range');
		}
		bar = systemStaff.NthBar(barNumber);
		ks = bar.AddKeySignatureFromText(0, keyName, major);
		if (ks = null) {
			return CreateDictionary('error', 'AddKeySignatureFromText failed for ' & keyName);
		}
		return CreateDictionary('bar', barNumber, 'name', ks.AsText, 'sharps', ks.Sharps, 'major', ks.Major);
	}"

	SetTimeSignature "(barNumber, top, bottom, useSymbol) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		systemStaff = score.SystemStaff;
		if (barNumber < 1 or barNumber > systemStaff.BarCount) {
			return CreateDictionary('error', 'barNumber out of range');
		}
		bar = systemStaff.NthBar(barNumber);
		symbol = False;
		if (useSymbol != null and useSymbol = True) {
			symbol = True;
		}
		err = bar.AddTimeSignature(top, bottom, True, True, symbol);
		if (err != '') {
			return CreateDictionary('error', err);
		}
		ts = systemStaff.CurrentTimeSignature(barNumber);
		style = 'numeric';
		if (ts.Text = CommonTimeString) {
			style = 'common';
		}
		if (ts.Text = AllaBreveTimeString) {
			style = 'cut';
		}
		return CreateDictionary(
			'bar', barNumber, 'numerator', ts.Numerator, 'denominator', ts.Denominator, 'style', style);
	}"

	SetBracketed "(staffNum, barNumber, index, bracketed) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null or obj.Type != 'NoteRest') {
			return CreateDictionary('error', 'bracket target must be a NoteRest object');
		}
		if (obj.NoteCount < 1) {
			return CreateDictionary('error', 'cannot bracket a rest');
		}
		newBracketed = True;
		if (bracketed != null and bracketed = False) {
			newBracketed = False;
		}
		changed = 0;
		for each note in obj {
			note.Bracketed = newBracketed;
			changed = changed + 1;
		}
		return CreateDictionary(
			'staff', staffNum, 'bar', barNumber, 'index', index, 'bracketed', newBracketed, 'notes', changed);
	}"

	InsertIrregularBar "(barNumber, length) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (barNumber < 1 or barNumber > score.SystemStaff.BarCount + 1) {
			return CreateDictionary('error', 'barNumber out of range');
		}
		if (length < 1) {
			return CreateDictionary('error', 'length must be positive');
		}
		score.InsertBars(1, barNumber, length);
		return CreateDictionary('inserted', 1, 'bar', barNumber, 'length', length);
	}"

	SetBarNumber "(barNumber, newNumber, skipThisBar) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (barNumber < 1 or barNumber > score.SystemStaff.BarCount) {
			return CreateDictionary('error', 'barNumber out of range');
		}
		skip = False;
		if (skipThisBar = True or skipThisBar = 1 or skipThisBar = 'true') {
			skip = True;
		}
		bar = score.SystemStaff.NthBar(barNumber);
		bar.AddBarNumber(newNumber, 0, '', False, skip);
		return CreateDictionary('bar', barNumber, 'number', newNumber, 'skipThisBar', skip);
	}"

	CreateStaff "(styleId, position, fullName, shortName) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (styleId = null or styleId = '') {
			return CreateDictionary('error', 'styleId is required');
		}
		changeNames = False;
		fn = '';
		sn = '';
		if (fullName != null and fullName != '') {
			changeNames = True;
			fn = fullName;
		}
		if (shortName != null and shortName != '') {
			changeNames = True;
			sn = shortName;
		}
		pos = 'bottom';
		if (position != null and position != '') {
			pos = position;
		}
		stave = null;
		if (pos = 'top') {
			if (changeNames) {
				stave = score.CreateInstrumentAtTopReturnStave(styleId, True, fn, sn);
			} else {
				stave = score.CreateInstrumentAtTopReturnStave(styleId);
			}
		}
		if (pos = 'auto') {
			if (changeNames) {
				stave = score.CreateInstrumentReturnStave(styleId, True, fn, sn);
			} else {
				stave = score.CreateInstrumentReturnStave(styleId);
			}
		}
		if (pos = 'bottom') {
			if (changeNames) {
				stave = score.CreateInstrumentAtBottomReturnStave(styleId, True, fn, sn);
			} else {
				stave = score.CreateInstrumentAtBottomReturnStave(styleId);
			}
		}
		if (stave = null) {
			return CreateDictionary('error', 'CreateInstrument failed for style ID: ' & styleId);
		}
		return CreateDictionary(
			'staffNum', stave.StaffNum,
			'instrumentName', stave.InstrumentName,
			'fullInstrumentName', stave.FullInstrumentName,
			'shortInstrumentName', stave.ShortInstrumentName,
			'barCount', stave.BarCount,
			'totalStaves', score.StaffCount);
	}"

	AddStaffToInstrument "(staffNum, above, ossia) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		staff = score.NthStaff(staffNum);
		isOssia = False;
		if (ossia != null and ossia = True) {
			isOssia = True;
		}
		stave = null;
		if (above != null and above = True) {
			stave = staff.AddStaffAbove(isOssia);
		} else {
			stave = staff.AddStaffBelow(isOssia);
		}
		if (stave = null) {
			return CreateDictionary('error', 'AddStaff failed');
		}
		return CreateDictionary(
			'staffNum', stave.StaffNum,
			'instrumentName', stave.InstrumentName,
			'barCount', stave.BarCount,
			'totalStaves', score.StaffCount);
	}"

	AddBars "(count) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (count = null or count < 1) {
			return CreateDictionary('error', 'count must be at least 1');
		}
		score.AddBars(count);
		return CreateDictionary(
			'addedBars', count,
			'totalBars', score.SystemStaff.BarCount);
	}"

	AddNotes "(staffNum, barNumber, position, duration, pitches, voice, tied) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		staff = score.NthStaff(staffNum);
		if (barNumber < 1 or barNumber > staff.BarCount) {
			return CreateDictionary('error', 'barNumber out of range');
		}
		if (pitches = null or pitches.Length < 1) {
			return CreateDictionary('error', 'pitches is empty');
		}
		v = 1;
		if (voice != null and voice >= 1 and voice <= 4) {
			v = voice;
		}
		isTied = False;
		if (tied != null and tied = True) {
			isTied = True;
		}
		bar = staff.NthBar(barNumber);
		added = CreateSparseArray();
		firstNote = bar.AddNote(position, pitches[0], duration, isTied, v);
		if (firstNote = null) {
			return CreateDictionary('error', 'AddNote failed');
		}
		added.Push(CreateDictionary('pitch', firstNote.Pitch, 'name', firstNote.Name, 'tied', firstNote.Tied));
		noteRest = firstNote.ParentNoteRest;
		if (pitches.Length > 1) {
			for i = 1 to pitches.Length {
				note = noteRest.AddNote(pitches[i], isTied);
				if (note != null) {
					added.Push(CreateDictionary('pitch', note.Pitch, 'name', note.Name, 'tied', note.Tied));
				}
			}
		}
		return CreateDictionary(
			'staff', staffNum, 'bar', barNumber, 'position', position,
			'duration', duration, 'voice', v, 'notes', added);
	}"

	AddNoteSequence "(staffNum, barNumber, startPosition, sequence, voice) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		staff = score.NthStaff(staffNum);
		if (barNumber < 1 or barNumber > staff.BarCount) {
			return CreateDictionary('error', 'barNumber out of range');
		}
		if (sequence = null or sequence.Length < 1) {
			return CreateDictionary('error', 'sequence is empty');
		}
		v = 1;
		if (voice != null and voice >= 1 and voice <= 4) {
			v = voice;
		}
		currBarNum = barNumber;
		currPos = 0;
		if (startPosition != null and startPosition >= 0) {
			currPos = startPosition;
		}
		addedCount = 0;
		for i = 0 to sequence.Length {
			item = sequence[i];
			dur = item['duration'];
			itemPitches = item['pitches'];
			itemTied = False;
			if (item['tied'] != null and item['tied'] = True) {
				itemTied = True;
			}
			if (item['bar'] != null) {
				currBarNum = item['bar'];
			}
			if (item['position'] != null) {
				currPos = item['position'];
			}
			if (currBarNum > staff.BarCount) {
				i = sequence.Length + 1;
			} else {
				bar = staff.NthBar(currBarNum);
				if (currPos >= bar.Length) {
					currBarNum = currBarNum + 1;
					currPos = 0;
				}
				if (currBarNum <= staff.BarCount) {
					bar = staff.NthBar(currBarNum);
					if (itemPitches != null and itemPitches.Length > 0) {
						firstNote = bar.AddNote(currPos, itemPitches[0], dur, itemTied, v);
						if (firstNote != null) {
							addedCount = addedCount + 1;
							noteRest = firstNote.ParentNoteRest;
							if (itemPitches.Length > 1) {
								for p = 1 to itemPitches.Length {
									noteRest.AddNote(itemPitches[p], itemTied);
								}
							}
						}
					}
					currPos = currPos + dur;
				}
			}
		}
		return CreateDictionary(
			'staff', staffNum, 'startBar', barNumber, 'addedNotes', addedCount);
	}"

	AddLyric "(staffNum, barNumber, position, duration, text, syllableType) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		staff = score.NthStaff(staffNum);
		if (barNumber < 1 or barNumber > staff.BarCount) {
			return CreateDictionary('error', 'barNumber out of range');
		}
		st = EndOfWord;
		if (syllableType = 'middle') {
			st = MiddleOfWord;
		}
		bar = staff.NthBar(barNumber);
		lyric = bar.AddLyric(position, duration, text, st);
		if (lyric = null) {
			return CreateDictionary('error', 'AddLyric failed');
		}
		return CreateDictionary(
			'staff', staffNum, 'bar', barNumber, 'position', lyric.Position, 'text', lyric.Text);
	}"

	AddLyrics "(items) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (items = null or items.Length < 1) {
			return CreateDictionary('error', 'items is empty');
		}
		added = 0;
		for i = 0 to items.Length {
			item = items[i];
			staffNum = item['staff'];
			barNumber = item['bar'];
			position = item['position'];
			duration = item['duration'];
			text = item['text'];
			syllableType = item['syllableType'];
			if (staffNum < 1 or staffNum > score.StaffCount) {
				return CreateDictionary('error', 'staffNum out of range at item ' & i);
			}
			staff = score.NthStaff(staffNum);
			if (barNumber < 1 or barNumber > staff.BarCount) {
				return CreateDictionary('error', 'barNumber out of range at item ' & i);
			}
			st = EndOfWord;
			if (syllableType = 'middle') {
				st = MiddleOfWord;
			}
			voice = 1;
			if (item['voice'] != null and item['voice'] >= 1 and item['voice'] <= 4) {
				voice = item['voice'];
			}
			bar = staff.NthBar(barNumber);
			lyric = bar.AddLyric(position, duration, text, st, 1, voice);
			if (lyric = null) {
				return CreateDictionary('error', 'AddLyric failed at item ' & i);
			}
			if (item['hidden'] = True or item['hidden'] = 1 or item['hidden'] = 'true') {
				lyric.Hidden = True;
			}
			if (item['styleId'] != null and item['styleId'] != '') {
				targetStyleId = '' & item['styleId'];
				if (targetStyleId = 'verse5') {
					targetStyleId = 'text.staff.space.hypen.lyrics.verse5';
				}
				lyric.StyleId = targetStyleId;
			}
			if (item['dy'] != null) {
				lyric.Dy = item['dy'];
			}
			added = added + 1;
		}
		return CreateDictionary('added', added);
	}"

	RelocateLyrics "(items) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (items = null or items.Length < 1) {
			return CreateDictionary('error', 'items is empty');
		}
		for i = 0 to items.Length {
			item = items[i];
			staff = score.NthStaff(item['staff']);
			if (staff = null) {
				return CreateDictionary('error', 'invalid staff at item ' & i);
			}
			obj = GetObjectAt(item['staff'], item['fromBar'], item['fromIndex']);
			if (obj = null or obj.Type != 'LyricItem') {
				return CreateDictionary('error', 'source is not a lyric at item ' & i);
			}
			name = 'relocateLyricSource' & i;
			@name = obj;
		}
		sel = score.Selection;
		for i = 0 to items.Length {
			item = items[i];
			name = 'relocateLyricSource' & i;
			obj = @name;
			st = EndOfWord;
			if (item['syllableType'] = 'middle') {
				st = MiddleOfWord;
			}
			if (item['updateOnly']) {
				obj.Text = item['text'];
				obj.SyllableType = st;
			}
			else {
				sel.Clear();
				obj.Select();
				sel.Copy(1);
				if (item['keepSourceText'] != null) {
					obj.Text = item['keepSourceText'];
					if (item['keepSourceSyllableType'] = 'middle') {
						obj.SyllableType = MiddleOfWord;
					}
					else {
						obj.SyllableType = EndOfWord;
					}
				}
				else {
					obj.Delete();
				}
				if (sel.PasteToPosition(item['staff'], item['bar'], item['position'], 1, False) != True) {
					return CreateDictionary('error', 'PasteToPosition failed at item ' & i);
				}
			}
		}
		score.Redraw = True;
		return CreateDictionary('relocated', items.Length);
	}"

	CopyLyricsBetweenStaves "(fromStaffNum, toStaffNum) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (fromStaffNum = toStaffNum) {
			return CreateDictionary('error', 'source and destination staves must differ');
		}
		sourceStaff = score.NthStaff(fromStaffNum);
		destinationStaff = score.NthStaff(toStaffNum);
		if (sourceStaff = null or destinationStaff = null) {
			return CreateDictionary('error', 'source or destination staff does not exist');
		}

		for barNum = 1 to destinationStaff.BarCount + 1 {
			destinationBar = destinationStaff.NthBar(barNum);
			for each destinationObject in destinationBar {
				if (destinationObject.Type = 'LyricItem') {
					return CreateDictionary('error', 'destination staff already contains lyrics');
				}
			}
		}

		selection = score.Selection;
		copied = 0;
		for barNum = 1 to sourceStaff.BarCount + 1 {
			sourceBar = sourceStaff.NthBar(barNum);
			for each sourceObject in sourceBar {
				if (sourceObject.Type = 'LyricItem') {
					selection.Clear();
					sourceObject.Select();
					selection.Copy(1);
					if (selection.PasteToPosition(toStaffNum, barNum, sourceObject.Position, 1, False) != True) {
						selection.Clear();
						return CreateDictionary('error', 'PasteToPosition failed at bar ' & barNum);
					}
					copied = copied + 1;
				}
			}
		}
		selection.Clear();
		score.Redraw = True;
		return CreateDictionary('copied', copied);
	}"

	DeleteObject "(staffNum, barNumber, index) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		deleted = DescribeObject(obj, index);
		obj.Delete();
		return CreateDictionary('deleted', deleted);
	}"

	DeleteSystemTimeSignature "(barNumber) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		systemStaff = score.SystemStaff;
		if (barNumber < 1 or barNumber > systemStaff.BarCount) {
			return CreateDictionary('error', 'bar number out of range');
		}
		bar = systemStaff.NthBar(barNumber);
		target = bar[0];
		if (target = null or target.Type != 'TimeSignature') {
			return CreateDictionary('error', 'no time signature at that bar');
		}
		deleted = CreateDictionary(
			'type', 'TimeSignature', 'numerator', target.Numerator,
			'denominator', target.Denominator);
		target.Delete();
		return CreateDictionary('deleted', deleted);
	}"

	HideSystemTimeSignature "(barNumber) {
		score = RequireScore();
		if (score = null) { return CreateDictionary('error', 'no score open'); }
		bar = score.SystemStaff.NthBar(barNumber);
		target = bar[0];
		if (target = null or target.Type != 'TimeSignature') {
			return CreateDictionary('error', 'no time signature at that bar');
		}
		target.Hidden = True;
		return CreateDictionary('bar', barNumber, 'hidden', target.Hidden);
	}"

	AddVersion "(name, comment) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		versions = score.GetVersions();
		version = versions.AddVersion(name, comment);
		if (version = null) {
			return CreateDictionary('error', 'AddVersion failed (has the score ever been saved?)');
		}
		return CreateDictionary('name', name, 'versionCount', versions.NumChildren);
	}"

	CopyPassage "(fromBar, toBar, topStaff, bottomStaff, destStaff, destBar, destPosition) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (fromBar < 1 or toBar > score.SystemStaff.BarCount or fromBar > toBar) {
			return CreateDictionary('error', 'source bar range out of range');
		}
		if (topStaff < 1 or bottomStaff > score.StaffCount or topStaff > bottomStaff) {
			return CreateDictionary('error', 'source staff range out of range');
		}
		if (destStaff < 1 or destStaff > score.StaffCount) {
			return CreateDictionary('error', 'destStaff out of range');
		}
		if (destBar < 1 or destBar > score.SystemStaff.BarCount) {
			return CreateDictionary('error', 'destBar out of range');
		}
		selection = score.Selection;
		selection.SelectPassage(fromBar, toBar, topStaff, bottomStaff);
		selection.Copy();
		ok = selection.PasteToPosition(destStaff, destBar, destPosition);
		selection.Clear();
		if (ok != True) {
			return CreateDictionary('error', 'PasteToPosition failed');
		}
		return CreateDictionary(
			'fromBar', fromBar, 'toBar', toBar,
			'topStaff', topStaff, 'bottomStaff', bottomStaff,
			'destStaff', destStaff, 'destBar', destBar, 'destPosition', destPosition);
	}"

	SetNotePitch "(staffNum, barNumber, index, oldPitch, newPitch) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		if (obj.Type != 'NoteRest') {
			return CreateDictionary('error', 'object at address is a ' & obj.Type & ', not a NoteRest');
		}
		oldNote = null;
		for each note in obj {
			if (note.Pitch = oldPitch) {
				oldNote = note;
			}
		}
		if (oldNote = null) {
			return CreateDictionary('error', 'no note with pitch ' & oldPitch & ' at that address');
		}
		wasTied = oldNote.Tied;
		oldName = oldNote.Name;
		newNote = obj.AddNote(newPitch, wasTied);
		if (newNote = null) {
			return CreateDictionary('error', 'AddNote failed for pitch ' & newPitch);
		}
		obj.RemoveNote(oldNote);
		return CreateDictionary(
			'oldPitch', oldPitch, 'oldName', oldName,
			'newPitch', newNote.Pitch, 'newName', newNote.Name, 'tied', wasTied);
	}"

	SetTie "(staffNum, barNumber, index, tied) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null or obj.Type != 'NoteRest') {
			return CreateDictionary('error', 'tie target must be a NoteRest object');
		}
		if (obj.NoteCount < 1) {
			return CreateDictionary('error', 'cannot tie a rest');
		}
		newTied = True;
		if (tied != null and tied = False) {
			newTied = False;
		}
		changed = 0;
		for each note in obj {
			note.Tied = newTied;
			changed = changed + 1;
		}
		return CreateDictionary('staff', staffNum, 'bar', barNumber, 'index', index, 'tied', newTied, 'notes', changed);
	}"

	DeleteVoiceInPassage "(fromBar, toBar, staffNum, voice) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (fromBar < 1 or toBar > score.SystemStaff.BarCount or fromBar > toBar) {
			return CreateDictionary('error', 'bar range out of range');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		if (voice < 1 or voice > 4) {
			return CreateDictionary('error', 'voice must be 1-4');
		}
		selection = score.Selection;
		selection.SelectPassage(fromBar, toBar, staffNum, staffNum);
		Sibelius.Execute('filter_voice' & voice & '_only');
		Sibelius.Execute('delete');
		selection.Clear();
		return CreateDictionary(
			'fromBar', fromBar, 'toBar', toBar, 'staff', staffNum, 'deletedVoice', voice);
	}"

	FlipStem "(staffNum, barNumber, index) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		if (obj.Type != 'NoteRest') {
			return CreateDictionary('error', 'object at address is a ' & obj.Type & ', not a NoteRest');
		}
		obj.FlipStem();
		return CreateDictionary('flipped', True, 'staff', staffNum, 'bar', barNumber, 'index', index);
	}"

	SetBeamGroup "(staffNum, barNumber, firstIndex, lastIndex) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (firstIndex > lastIndex) {
			return CreateDictionary('error', 'firstIndex must not exceed lastIndex');
		}
		first = GetObjectAt(staffNum, barNumber, firstIndex);
		last = GetObjectAt(staffNum, barNumber, lastIndex);
		if (first = null or last = null) {
			return CreateDictionary('error', 'no object at a beam endpoint');
		}
		if (first.Type != 'NoteRest' or last.Type != 'NoteRest') {
			return CreateDictionary('error', 'beam endpoints must be NoteRest objects');
		}
		staff = score.NthStaff(staffNum);
		bar = staff.NthBar(barNumber);
		noteCount = 0;
		for i = firstIndex to lastIndex + 1 {
			obj = GetObjectAt(staffNum, barNumber, i);
			if (obj != null and obj.Type = 'NoteRest') {
				noteCount = noteCount + 1;
				if (i = firstIndex) {
					obj.Beam = StartBeam;
				} else {
					if (i = lastIndex) {
						obj.Beam = SingleBeam;
					} else {
						obj.Beam = ContinueBeam;
					}
				}
			}
		}
		if (noteCount < 2) {
			return CreateDictionary('error', 'beam group must contain at least two NoteRest objects');
		}
		return CreateDictionary(
			'staff', staffNum, 'bar', barNumber,
			'firstIndex', firstIndex, 'lastIndex', lastIndex,
			'noteCount', noteCount, 'firstBeam', first.Beam, 'lastBeam', last.Beam);
	}"

	NudgeObject "(staffNum, barNumber, index, dx, dy) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		oldDx = obj.Dx;
		oldDy = obj.Dy;
		obj.Dx = oldDx + dx;
		obj.Dy = oldDy + dy;
		return CreateDictionary(
			'type', obj.Type, 'oldDx', oldDx, 'newDx', obj.Dx,
			'oldDy', oldDy, 'newDy', obj.Dy);
	}"

	OpenScore "(fileName) {
		ok = Sibelius.Open(fileName, True);
		if (ok != True) {
			return CreateDictionary('error', 'could not open ' & fileName);
		}
		score = Sibelius.ActiveScore;
		return CreateDictionary('fileName', score.FileName & '');
	}"

	ExportScore "(fileName, format) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		score.SaveAs(fileName, format);
		return CreateDictionary('exportedTo', fileName, 'format', format,
			'stillOpen', score.FileName & '');
	}"

	Save "() {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		fileName = score.FileName & '';
		// An imported MusicXML score reports a bare title, not a path.
		if (fileName = '' or Substring(fileName, 0, 1) != '/') {
			return CreateDictionary('error', 'score has never been saved; save it in Sibelius first');
		}
		score.Save(fileName);
		return CreateDictionary('fileName', fileName);
	}"

	SetStaffName "(staffNum, fullName, shortName) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		staff = score.NthStaff(staffNum);
		if (fullName != null and fullName != '') {
			staff.FullInstrumentName = '' & fullName;
			staff.FullStaffName = '' & fullName;
		}
		if (shortName != null and shortName != '') {
			staff.ShortInstrumentName = '' & shortName;
			staff.ShortStaffName = '' & shortName;
		}
		return CreateDictionary(
			'staffNum', staffNum,
			'fullInstrumentName', staff.FullInstrumentName,
			'shortInstrumentName', staff.ShortInstrumentName);
	}"

	SetInitialInstrument "(staffNum, styleId) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		if (styleId = null or styleId = '') {
			return CreateDictionary('error', 'styleId is required');
		}
		staff = score.NthStaff(staffNum);
		bar = staff.NthBar(1);
		change = bar.AddInstrumentChange(0, styleId, False, False);
		if (change = null) {
			return CreateDictionary('error', 'AddInstrumentChange failed');
		}
		return CreateDictionary('staffNum', staffNum, 'styleId', styleId);
	}"

	DuplicateOctaveDownToVoice2 "(staffNum, fromBar, toBar) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		staff = score.NthStaff(staffNum);
		if (fromBar < 1 or toBar < fromBar or toBar > staff.BarCount) {
			return CreateDictionary('error', 'invalid bar range');
	}
	added = 0;
	lastBar = toBar + 1;
	for barNum = fromBar to lastBar {
		bar = staff.NthBar(barNum);
		found = False;
		pitch = 0;
		position = 0;
		duration = 0;
		for each obj in bar {
			if (found = False and obj.Type = 'NoteRest' and obj.VoiceNumber = 1) {
				for each note in obj {
					for each other in obj {
						if (other.Pitch = (note.Pitch + 12)) {
							pitch = note.Pitch;
							position = obj.Position;
							duration = obj.Duration;
							found = True;
						}
					}
				}
			}
		}
		if (found) {
			duplicate = bar.AddNote(position, pitch, duration, False, 2);
			duplicate.ParentNoteRest.Hidden = True;
			added = added + 1;
		}
	}
		return CreateDictionary('staffNum', staffNum, 'fromBar', fromBar, 'toBar', toBar, 'added', added);
	}"

	SetScoreInfo "(title, composer, lyricist) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (title != null and title != '') {
			score.Title = '' & title;
		}
		if (composer != null and composer != '') {
			score.Composer = '' & composer;
		}
		if (lyricist != null and lyricist != '') {
			score.Lyricist = '' & lyricist;
		}
		return CreateDictionary(
			'title', score.Title,
			'composer', score.Composer,
			'lyricist', score.Lyricist);
	}"

	SetBarBreak "(barNum, breakType) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		systemStaff = score.SystemStaff;
		if (barNum < 1 or barNum > systemStaff.BarCount) {
			return CreateDictionary('error', 'barNum out of range');
		}
		bar = systemStaff.NthBar(barNum);
		bType = MiddleOfSystem;
		if (breakType = 'system' or breakType = 'EndOfSystemOrPage' or breakType = 6) {
			bType = EndOfSystemOrPage;
		}
		if (breakType = 'page' or breakType = 'EndOfPage' or breakType = 4) {
			bType = EndOfPage;
		}
		// Clearing a break means Default (bar can appear anywhere); MiddleOfSystem
		// would instead forbid a break here and pile the score onto one system.
		if (breakType = 'none' or breakType = 'Default' or breakType = 7) {
			bType = Default;
		}
		bar.BreakType = bType;
		return CreateDictionary(
			'bar', barNum,
			'breakType', '' & bar.BreakType);
	}"

	GetSpecialBarlines "(fromBar, toBar) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		systemStaff = score.SystemStaff;
		if (fromBar < 1 or toBar > systemStaff.BarCount or fromBar > toBar) {
			return CreateDictionary('error', 'bar range out of range');
		}
		results = CreateSparseArray();
		for barNum = fromBar to toBar + 1 {
			bar = systemStaff.NthBar(barNum);
			for each SpecialBarline sb in bar {
				results.Push(CreateDictionary(
					'bar', barNum,
					'type', sb.BarlineType,
					'internalType', sb.BarlineInternalType,
					'position', sb.Position));
			}
		}
		return results;
	}"

	SetSpecialBarline "(barNum, barlineType) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		systemStaff = score.SystemStaff;
		if (barNum < 1 or barNum > systemStaff.BarCount) {
			return CreateDictionary('error', 'barNum out of range');
		}
		bar = systemStaff.NthBar(barNum);
		toDelete = CreateSparseArray();
		for each SpecialBarline sb in bar {
			toDelete.Push(sb);
		}
		deleted = 0;
		if (toDelete.Length > 0) {
			for i = 0 to toDelete.Length {
				target = toDelete[i];
				if (target != null) {
					target.Delete();
					deleted = deleted + 1;
				}
			}
		}
		bType = -1;
		if (barlineType = 'start_repeat' or barlineType = 'StartRepeat' or barlineType = 0 or barlineType = '0') {
			bType = SpecialBarlineStartRepeat;
		}
		if (barlineType = 'end_repeat' or barlineType = 'EndRepeat' or barlineType = 1 or barlineType = '1') {
			bType = SpecialBarlineEndRepeat;
		}
		if (barlineType = 'dashed' or barlineType = 'Dashed' or barlineType = 2 or barlineType = '2') {
			bType = SpecialBarlineDashed;
		}
		if (barlineType = 'double' or barlineType = 'Double' or barlineType = 3 or barlineType = '3') {
			bType = SpecialBarlineDouble;
		}
		if (barlineType = 'final' or barlineType = 'Final' or barlineType = 4 or barlineType = '4') {
			bType = SpecialBarlineFinal;
		}
		if (barlineType = 'invisible' or barlineType = 'Invisible' or barlineType = 5 or barlineType = '5') {
			bType = SpecialBarlineInvisible;
		}
		if (barlineType = 'between_staves' or barlineType = 'BetweenStaves' or barlineType = 6 or barlineType = '6') {
			bType = SpecialBarlineBetweenStaves;
		}
		if (barlineType = 'normal' or barlineType = 'Normal' or barlineType = 7 or barlineType = '7' or barlineType = 'none') {
			bType = SpecialBarlineNormal;
		}
		if (barlineType = 'tick' or barlineType = 'Tick' or barlineType = 8 or barlineType = '8') {
			bType = SpecialBarlineTick;
		}
		if (barlineType = 'short' or barlineType = 'Short' or barlineType = 9 or barlineType = '9') {
			bType = SpecialBarlineShort;
		}
		if (barlineType = 'dotted' or barlineType = 'Dotted' or barlineType = 10 or barlineType = '10') {
			bType = SpecialBarlineDotted;
		}
		if (barlineType = 'triple' or barlineType = 'Triple' or barlineType = 11 or barlineType = '11') {
			bType = SpecialBarlineTriple;
		}
		if (barlineType = 'thick' or barlineType = 'Thick' or barlineType = 12 or barlineType = '12') {
			bType = SpecialBarlineThick;
		}
		if (bType >= 0 and bType != SpecialBarlineNormal) {
			bar.AddSpecialBarline(bType);
		}
		return CreateDictionary(
			'bar', barNum,
			'deleted', deleted,
			'barlineType', '' & bType);
	}"

	SetLyricStyle "(staffNum, barNumber, index, styleId) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		if (obj.Type != 'LyricItem') {
			return CreateDictionary('error', 'object at address is a ' & obj.Type & ', not a LyricItem');
		}
		oldStyleId = '' & obj.StyleId;
		targetStyleId = '' & styleId;
		if (styleId = 'verse1' or styleId = 'line1' or styleId = 1) {
			targetStyleId = 'text.staff.space.hypen.lyrics.verse1';
		}
		if (styleId = 'verse2' or styleId = 'line2' or styleId = 2) {
			targetStyleId = 'text.staff.space.hypen.lyrics.verse2';
		}
		if (styleId = 'verse3' or styleId = 'line3' or styleId = 3) {
			targetStyleId = 'text.staff.space.hypen.lyrics.verse3';
		}
		if (styleId = 'verse4' or styleId = 'line4' or styleId = 4) {
			targetStyleId = 'text.staff.space.hypen.lyrics.verse4';
		}
		if (styleId = 'verse5' or styleId = 'line5' or styleId = 5) {
			targetStyleId = 'text.staff.space.hypen.lyrics.verse5';
		}
		if (styleId = 'chorus') {
			targetStyleId = 'text.staff.space.hypen.lyrics.chorus';
		}
		if (styleId = 'above') {
			targetStyleId = 'text.staff.space.hypen.lyrics.above';
		}
		obj.StyleId = targetStyleId;
		return CreateDictionary(
			'staff', staffNum,
			'bar', barNumber,
			'index', index,
			'oldStyleId', oldStyleId,
			'newStyleId', '' & obj.StyleId);
	}"

	GetLayoutInfo "() {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		setup = score.DocumentSetup;
		return CreateDictionary(
			'pageCount', score.PageCount,
			'pageSize', setup.PageSize,
			'orientation', setup.Orientation,
			'pageWidth', setup.PageWidth,
			'pageHeight', setup.PageHeight,
			'staffSize', setup.StaffSize,
			'pageTopMargin', setup.PageTopMargin,
			'pageBottomMargin', setup.PageBottomMargin,
			'pageLeftMargin', setup.PageLeftMargin,
			'pageRightMargin', setup.PageRightMargin,
			'aboveTopStaveGap', setup.AboveTopStaveGap,
			'belowBottomStaveGap', setup.BelowBottomStaveGap);
	}"

	SetDocumentLayout "(pageSize, orientation, staffSize, pageMargin, verticalStaveGap) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		setup = score.DocumentSetup;
		setup.PageSize = pageSize;
		setup.Orientation = orientation;
		setup.PageTopMargin = pageMargin;
		setup.PageBottomMargin = pageMargin;
		setup.PageLeftMargin = pageMargin;
		setup.PageRightMargin = pageMargin;
		setup.StaffSize = staffSize;
		setup.AboveTopStaveGap = verticalStaveGap;
		setup.BelowBottomStaveGap = verticalStaveGap;
		score.Redraw = True;
		return GetLayoutInfo();
	}"

	HideEmptyStaves "(startBar, endBar) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (startBar < 1 or endBar > score.SystemStaff.BarCount or startBar > endBar) {
			return CreateDictionary('error', 'bar range out of range');
		}
		score.HideEmptyStaves(1, score.StaffCount, startBar, endBar);
		score.OptimizeStaffSpacing(1, score.StaffCount, startBar, endBar);
		score.Redraw = True;
		return CreateDictionary('startBar', startBar, 'endBar', endBar, 'pageCount', score.PageCount);
	}"

	SetLyricSpan "(staffNum, barNumber, index, numNotes) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (numNotes < 1) {
			return CreateDictionary('error', 'numNotes must be at least 1');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		if (obj.Type != 'LyricItem') {
			return CreateDictionary('error', 'object at address is a ' & obj.Type & ', not a LyricItem');
		}
		oldNumNotes = obj.NumNotes;
		oldDuration = obj.Duration;
		obj.NumNotes = numNotes;
		score.Redraw = True;
		return CreateDictionary(
			'staff', staffNum,
			'bar', barNumber,
			'index', index,
			'text', obj.Text,
			'oldNumNotes', oldNumNotes,
			'newNumNotes', obj.NumNotes,
			'oldDuration', oldDuration,
			'newDuration', obj.Duration);
	}"

	SetLyricDuration "(staffNum, barNumber, index, duration) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (duration < 1) {
			return CreateDictionary('error', 'duration must be at least 1');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		if (obj.Type != 'LyricItem') {
			return CreateDictionary('error', 'object at address is a ' & obj.Type & ', not a LyricItem');
		}
		oldDuration = obj.Duration;
		oldNumNotes = obj.NumNotes;
		obj.Duration = duration;
		score.Redraw = True;
		return CreateDictionary(
			'staff', staffNum,
			'bar', barNumber,
			'index', index,
			'text', obj.Text,
			'oldNumNotes', oldNumNotes,
			'newNumNotes', obj.NumNotes,
			'oldDuration', oldDuration,
			'newDuration', obj.Duration);
	}"

	GetEngravingRules "() {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		rules = score.EngravingRules;
		return CreateDictionary(
			'spacesBetweenStaves', rules.SpacesBetweenStaves,
			'extraSpacesBelowVocalStaves', rules.ExtraSpacesBelowVocalStaves,
			'spacesBetweenSystems', rules.SpacesBetweenSystems);
	}"

	SetStaffSpacing "(spacesBetweenStaves, extraSpacesBelowVocal, spacesBetweenSystems) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		rules = score.EngravingRules;
		if (spacesBetweenStaves > 0) {
			rules.SpacesBetweenStaves = spacesBetweenStaves;
		}
		if (extraSpacesBelowVocal >= 0) {
			rules.ExtraSpacesBelowVocalStaves = extraSpacesBelowVocal;
		}
		if (spacesBetweenSystems > 0) {
			rules.SpacesBetweenSystems = spacesBetweenSystems;
		}
		score.Redraw = True;
		return CreateDictionary(
			'spacesBetweenStaves', rules.SpacesBetweenStaves,
			'extraSpacesBelowVocal', rules.ExtraSpacesBelowVocalStaves,
			'spacesBetweenSystems', rules.SpacesBetweenSystems);
	}"

	SetLyricPosition "(staffNum, barNumber, index, dy) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		if (obj.Type != 'LyricItem') {
			return CreateDictionary('error', 'object at address is a ' & obj.Type & ', not a LyricItem');
		}
		oldDy = obj.Dy;
		obj.Dy = dy;
		score.Redraw = True;
		return CreateDictionary(
			'staff', staffNum,
			'bar', barNumber,
			'index', index,
			'oldDy', oldDy,
			'newDy', obj.Dy);
	}"

	SetObjectHidden "(staffNum, barNumber, index, hidden) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		obj = GetObjectAt(staffNum, barNumber, index);
		if (obj = null) {
			return CreateDictionary('error', 'no object at that address');
		}
		oldHidden = obj.Hidden;
		if (hidden = True or hidden = 1 or hidden = 'true') {
			obj.Hidden = True;
		} else {
			obj.Hidden = False;
		}
		score.Redraw = True;
		return CreateDictionary(
			'staff', staffNum,
			'bar', barNumber,
			'index', index,
			'oldHidden', oldHidden,
			'newHidden', obj.Hidden);
	}"

	SetStaffLyricsHidden "(staffNum, fromBar, toBar, hidden) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		staff = score.NthStaff(staffNum);
		if (fromBar < 1) {
			fromBar = 1;
		}
		if (toBar < 1 or toBar > staff.BarCount) {
			toBar = staff.BarCount;
		}
		hVal = False;
		if (hidden = True or hidden = 1 or hidden = 'true') {
			hVal = True;
		}
		count = 0;
		for b = fromBar to toBar + 1 {
			bar = staff.NthBar(b);
			for each LyricItem lyric in bar {
				lyric.Hidden = hVal;
				count = count + 1;
			}
		}
		score.Redraw = True;
		return CreateDictionary(
			'staff', staffNum,
			'fromBar', fromBar,
			'toBar', toBar,
			'count', count,
			'hidden', hVal);
	}"

	ConvertVerse6ToRoman "(staffNum, fromBar, toBar) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return CreateDictionary('error', 'staffNum out of range');
		}
		staff = score.NthStaff(staffNum);
		if (fromBar < 1) {
			fromBar = 1;
		}
		if (toBar < 1 or toBar > staff.BarCount) {
			toBar = staff.BarCount;
		}
		converted = 0;
		for b = fromBar to toBar + 1 {
			bar = staff.NthBar(b);
			for each LyricItem lyric in bar {
				if (lyric.StyleId = 'text.staff.space.hypen.lyrics.chorus') {
					oldDy = lyric.Dy;
					lyric.StyleId = 'text.staff.space.hypen.lyrics.verse5';
					if (oldDy != 0) {
						lyric.Dy = oldDy;
					} else {
						lyric.Dy = -592;
					}
					converted = converted + 1;
				}
			}
		}
		score.Redraw = True;
		return CreateDictionary('converted', converted);
	}"

	QueryPropTable "() {
		// Properties Query may read through obj.@name, per object kind. An
		// unknown name raises a modal dialog that blocks Sibelius (SPEC.md
		// 1.3.1), so nothing outside this table is ever dereferenced.
		// Mirrored by query.py READABLE_PROPS; a test keeps them in sync.
		common = CreateDictionary(
			'Position', True, 'VoiceNumber', True, 'Hidden', True, 'Dx', True,
			'Dy', True, 'CueSize', True, 'Selected', True, 'Type', True);
		types = CreateDictionary(
			'NoteRest', CreateDictionary(
				'Duration', True, 'NoteCount', True, 'Beam', True, 'GraceNote', True,
				'StemFlipped', True, 'CrossStaff', True, 'RestPosition', True),
			'LyricItem', CreateDictionary(
				'Duration', True, 'Text', True, 'StyleId', True, 'StyleAsText', True),
			'Text', CreateDictionary(
				'Text', True, 'StyleId', True, 'StyleAsText', True),
			'Line', CreateDictionary(
				'Duration', True, 'EndBarNumber', True, 'EndPosition', True,
				'StyleId', True, 'StyleAsText', True, 'RhDx', True),
			'Clef', CreateDictionary(
				'StyleId', True, 'ConcertClefStyleId', True),
			'KeySignature', CreateDictionary(
				'AsText', True, 'Major', True, 'Sharps', True),
			'TimeSignature', CreateDictionary(
				'Numerator', True, 'Denominator', True, 'Text', True),
			'Tuplet', CreateDictionary(
				'Text', True, 'FullDuration', True));
		return CreateDictionary('common', common, 'types', types);
	}"

	QueryKind "(obj) {
		if (obj.IsALine) {
			return 'Line';
		}
		return obj.Type;
	}"

	QueryIsReadable "(table, kind, prop) {
		common = table['common'];
		if (common[prop] = True) {
			return True;
		}
		typeTable = table['types'];
		typeProps = typeTable[kind];
		if (typeProps = null) {
			return False;
		}
		if (typeProps[prop] = True) {
			return True;
		}
		return False;
	}"

	QueryCompare "(a, op, b) {
		result = False;
		if (op = '=') {
			if (a = b) {
				result = True;
			}
		}
		if (op = '!=') {
			if (a != b) {
				result = True;
			}
		}
		if (op = '<') {
			if (a < b) {
				result = True;
			}
		}
		if (op = '<=') {
			if (a <= b) {
				result = True;
			}
		}
		if (op = '>') {
			if (a > b) {
				result = True;
			}
		}
		if (op = '>=') {
			if (a >= b) {
				result = True;
			}
		}
		return result;
	}"

	QueryMatches "(obj, kind, where, table) {
		if (where = null) {
			return True;
		}
		for i = 0 to where.Length {
			cond = where[i];
			prop = cond['prop'];
			op = cond['op'];
			value = cond['value'];
			if (prop = 'Pitch') {
				// Pseudo-property: true if any note of the chord matches.
				if (kind != 'NoteRest') {
					return False;
				}
				anyMatch = False;
				for each note in obj {
					if (QueryCompare(note.Pitch, op, value)) {
						anyMatch = True;
					}
				}
				if (anyMatch = False) {
					return False;
				}
			} else {
				if (QueryIsReadable(table, kind, prop) = False) {
					return False;
				}
				if (QueryCompare(obj.@prop, op, value) = False) {
					return False;
				}
			}
		}
		return True;
	}"

	QueryInList "(list, value) {
		for i = 0 to list.Length {
			if (list[i] = value) {
				return True;
			}
		}
		return False;
	}"

	Query "(selector) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		table = QueryPropTable();
		ops = CreateSparseArray('=', '!=', '<', '<=', '>', '>=');
		where = selector['where'];
		if (where != null) {
			for i = 0 to where.Length {
				cond = where[i];
				if (QueryInList(ops, cond['op']) = False) {
					return CreateDictionary('error', 'unsupported operator at where ' & i);
				}
			}
		}
		staves = selector['staves'];
		if (staves = null or staves.Length = 0) {
			staves = CreateSparseArray();
			for s = 1 to score.StaffCount + 1 {
				staves.Push(s);
			}
		}
		types = selector['types'];
		fields = selector['fields'];
		voice = selector['voice'];
		if (voice = null) {
			voice = 0;
		}
		limit = selector['limit'];
		if (limit = null or limit < 1) {
			limit = 500;
		}
		objects = CreateSparseArray();
		truncated = False;
		for si = 0 to staves.Length {
			staffNum = staves[si];
			if (staffNum < 1 or staffNum > score.StaffCount) {
				return CreateDictionary('error', 'staff ' & staffNum & ' out of range');
			}
			staff = score.NthStaff(staffNum);
			fromBar = selector['fromBar'];
			if (fromBar = null or fromBar < 1) {
				fromBar = 1;
			}
			toBar = selector['toBar'];
			if (toBar = null or toBar > staff.BarCount) {
				toBar = staff.BarCount;
			}
			for barNum = fromBar to toBar + 1 {
				index = 0;
				for each obj in staff.NthBar(barNum) {
					kind = QueryKind(obj);
					keep = True;
					if (types != null and types.Length > 0) {
						if (QueryInList(types, kind) = False and QueryInList(types, obj.Type) = False) {
							keep = False;
						}
					}
					if (keep and voice > 0 and obj.VoiceNumber != voice) {
						keep = False;
					}
					if (keep) {
						keep = QueryMatches(obj, kind, where, table);
					}
					if (keep) {
						if (objects.Length >= limit) {
							truncated = True;
						} else {
							d = DescribeObject(obj, index);
							d['staff'] = staffNum;
							d['bar'] = barNum;
							d['voice'] = obj.VoiceNumber;
							if (fields != null and fields.Length > 0) {
								values = CreateDictionary();
								for fi = 0 to fields.Length {
									prop = fields[fi];
									if (QueryIsReadable(table, kind, prop)) {
										values[prop] = obj.@prop;
									}
								}
								d['fields'] = values;
							}
							objects.Push(d);
						}
					}
					index = index + 1;
				}
			}
		}
		return CreateDictionary('objects', objects, 'count', objects.Length, 'truncated', truncated);
	}"

	BatchWritableTable "() {
		// Properties ApplyBatch 'set' may write through obj.@name, per object
		// kind. Mirrored by batch_ops.py WRITABLE_PROPS, which also checks value
		// types; a test keeps the two in sync.
		common = CreateDictionary('Dx', True, 'Dy', True, 'Hidden', True, 'CueSize', True);
		types = CreateDictionary(
			'NoteRest', CreateDictionary('Beam', True, 'RestPosition', True),
			'LyricItem', CreateDictionary('Text', True, 'Duration', True),
			'Text', CreateDictionary('Text', True),
			'Line', CreateDictionary('Duration', True, 'RhDx', True));
		return CreateDictionary('common', common, 'types', types);
	}"

	BatchAddressed "(opName) {
		if (opName = 'set' or opName = 'set-pitch' or opName = 'tie' or opName = 'bracket') {
			return True;
		}
		if (opName = 'flip-stem' or opName = 'delete') {
			return True;
		}
		return False;
	}"

	BatchBar "(score, op) {
		staffNum = op['staff'];
		if (staffNum < 1 or staffNum > score.StaffCount) {
			return null;
		}
		staff = score.NthStaff(staffNum);
		barNumber = op['bar'];
		if (barNumber < 1 or barNumber > staff.BarCount) {
			return null;
		}
		return staff.NthBar(barNumber);
	}"

	BatchCheck "(score, op, target, writable) {
		// Returns '' when op can run against the score as it is now.
		opName = op['op'];
		if (BatchAddressed(opName)) {
			if (target = null) {
				return 'no object at staff ' & op['staff'] & ' bar ' & op['bar'] & ' index ' & op['index'];
			}
			if (op['type'] != null) {
				if (target.Type != op['type'] and QueryKind(target) != op['type']) {
					return 'expected a ' & op['type'] & ' but found a ' & target.Type;
				}
			}
			if (op['position'] != null) {
				if (target.Position != op['position']) {
					return 'expected position ' & op['position'] & ' but found ' & target.Position;
				}
			}
			kind = QueryKind(target);
			if (opName = 'set') {
				if (QueryIsReadable(writable, kind, op['prop']) = False) {
					return 'property ' & op['prop'] & ' is not writable on a ' & target.Type;
				}
				return '';
			}
			if (opName = 'delete') {
				return '';
			}
			if (target.Type != 'NoteRest') {
				return opName & ' needs a NoteRest but found a ' & target.Type;
			}
			if (opName = 'set-pitch') {
				found = False;
				for each note in target {
					if (note.Pitch = op['oldPitch']) {
						found = True;
					}
				}
				if (found = False) {
					return 'no note with pitch ' & op['oldPitch'];
				}
			}
			if (opName = 'tie' or opName = 'bracket') {
				if (target.NoteCount < 1) {
					return 'cannot ' & opName & ' a rest';
				}
			}
			return '';
		}
		bar = BatchBar(score, op);
		if (bar = null) {
			return 'no bar ' & op['bar'] & ' on staff ' & op['staff'];
		}
		if (op['position'] < 0 or op['position'] >= bar.Length) {
			return 'position ' & op['position'] & ' is outside the bar';
		}
		return '';
	}"

	BatchRun "(score, op, target) {
		// Applies one checked op; returns a description of the result, or
		// null if Sibelius refused the change.
		opName = op['op'];
		if (opName = 'set') {
			prop = op['prop'];
			target.@prop = op['value'];
			return DescribeObject(target, op['index']);
		}
		if (opName = 'set-pitch') {
			oldNote = null;
			for each note in target {
				if (note.Pitch = op['oldPitch']) {
					oldNote = note;
				}
			}
			newNote = target.AddNote(op['newPitch'], oldNote.Tied);
			if (newNote = null) {
				return null;
			}
			target.RemoveNote(oldNote);
			return DescribeObject(target, op['index']);
		}
		if (opName = 'tie') {
			for each note in target {
				note.Tied = op['tied'];
			}
			return DescribeObject(target, op['index']);
		}
		if (opName = 'bracket') {
			for each note in target {
				note.Bracketed = op['bracketed'];
			}
			return DescribeObject(target, op['index']);
		}
		if (opName = 'flip-stem') {
			target.FlipStem();
			return DescribeObject(target, op['index']);
		}
		if (opName = 'delete') {
			target.Delete();
			return CreateDictionary('deleted', True);
		}
		bar = BatchBar(score, op);
		voice = 1;
		if (op['voice'] != null) {
			voice = op['voice'];
		}
		if (opName = 'add-note') {
			pitches = op['pitches'];
			tied = False;
			if (op['tied'] = True) {
				tied = True;
			}
			firstNote = bar.AddNote(op['position'], pitches[0], op['duration'], tied, voice);
			if (firstNote = null) {
				return null;
			}
			noteRest = firstNote.ParentNoteRest;
			for i = 1 to pitches.Length {
				noteRest.AddNote(pitches[i], tied);
			}
			return DescribeObject(noteRest, -1);
		}
		if (opName = 'add-text') {
			text = bar.AddText(op['position'], op['text'], op['styleId'], voice);
			if (text = null) {
				return null;
			}
			return DescribeObject(text, -1);
		}
		if (opName = 'add-lyric') {
			st = EndOfWord;
			if (op['syllableType'] = 'middle') {
				st = MiddleOfWord;
			}
			lyric = bar.AddLyric(op['position'], op['duration'], op['text'], st, 1, voice);
			if (lyric = null) {
				return null;
			}
			return DescribeObject(lyric, -1);
		}
		return null;
	}"

	ApplyBatch "(ops, dryRun) {
		score = RequireScore();
		if (score = null) {
			return CreateDictionary('error', 'no score open');
		}
		if (ops = null or ops.Length < 1) {
			return CreateDictionary('error', 'ops is empty');
		}
		writable = BatchWritableTable();
		// Resolve every address before the first edit: later edits shift bar
		// indices, but references taken now stay valid (SPEC.md 1.3.1).
		targets = CreateSparseArray();
		results = CreateSparseArray();
		for i = 0 to ops.Length {
			op = ops[i];
			target = null;
			if (BatchAddressed(op['op'])) {
				target = GetObjectAt(op['staff'], op['bar'], op['index']);
			}
			targets[i] = target;
			problem = BatchCheck(score, op, target, writable);
			if (problem != '') {
				return CreateDictionary('error', 'op ' & i & ': ' & problem, 'failedOp', i, 'applied', 0);
			}
			before = null;
			if (target != null) {
				before = DescribeObject(target, op['index']);
			}
			results.Push(CreateDictionary('i', i, 'op', op['op'], 'before', before));
		}
		if (dryRun = True) {
			return CreateDictionary('results', results, 'applied', 0, 'dryRun', True);
		}
		applied = 0;
		failure = '';
		for i = 0 to ops.Length {
			if (failure = '') {
				op = ops[i];
				after = BatchRun(score, op, targets[i]);
				result = results[i];
				if (after = null) {
					failure = 'op ' & i & ': Sibelius refused ' & op['op'];
				} else {
					result['after'] = after;
					applied = applied + 1;
				}
			}
		}
		if (failure != '') {
			return CreateDictionary('error', failure, 'failedOp', applied, 'applied', applied, 'results', results);
		}
		return CreateDictionary('results', results, 'applied', applied);
	}"
}
